{
  "name": "conspectus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:db && npm run test:e2e",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed-sample": "node scripts/seed-sample.ts",
    "db:test:up": "node scripts/test-db.ts up",
    "db:test:down": "node scripts/test-db.ts down",
    "test:db": "node scripts/test-db.ts prepare && vitest run --project db"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "linkedom": "^0.18.14",
    "next": "^16.4.3",
    "openai": "^7.45.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
